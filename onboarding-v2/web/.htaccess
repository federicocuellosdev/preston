# =====================================================================
# Preston — Web pública (SPA en la raíz del dominio)
# URLs por etapa:
#   /                        (landing)
#   /solicitar               (paso 1)
#   /solicitar/datos         (paso 2)
#   /solicitar/documentacion (paso 3)
#   /solicitar/listo         (final)
#   /equipo , /equipo/panel  (interno)
# El v1 sigue funcionando en /onboarding/ (carpeta física — Apache la
# sirve directo sin pasar por estas reglas).
# =====================================================================

# ---- Reescritura tipo SPA -------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # No tocar archivos ni carpetas reales (assets, Muli, /onboarding/, etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Todo lo demás se sirve con index.html (la app restaura la vista por JS)
  RewriteRule ^ index.html [L]
</IfModule>

# ---- Seguridad ------------------------------------------------------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"

  # index.html es el shell de la SPA: siempre revalidar (no cachear viejo)
  <FilesMatch "index\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# ---- Caché de estáticos (fuentes e imágenes con hash de contenido) --
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png        "access plus 1 year"
  ExpiresByType image/webp       "access plus 1 year"
  ExpiresByType image/jpeg       "access plus 1 year"
  ExpiresByType image/x-icon     "access plus 1 year"
  ExpiresByType image/svg+xml    "access plus 1 year"
  ExpiresByType font/woff2       "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
</IfModule>

# ---- Tipos MIME (cPanel viejo a veces no tiene webp registrado) ------
# Sin esto, algunos Apache sirven mal el .webp y la imagen de Carla no
# renderiza (el <picture> no cae al .png). Esta línea lo evita.
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/svg+xml .svg
  AddType image/x-icon .ico
  AddType font/woff2 .woff2
</IfModule>

# ---- Compresión -----------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain \
    application/javascript application/json image/svg+xml
</IfModule>

# =====================================================================
# NOTA: a diferencia de la demo privada de Netlify, esta config NO lleva
# noindex ni robots Disallow, porque el sitio va a producción y necesita
# indexarse para las campañas. El panel interno (/equipo, /equipo/panel)
# es una demo: si más adelante querés bloquearlo de buscadores, se agrega
# una regla puntual acá.
# =====================================================================
